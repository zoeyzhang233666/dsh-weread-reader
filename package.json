{
  "name": "dsh-weread-reader",
  "version": "0.1.5",
  "description": "WeChat Reading reader for DeepSeek Harness: QR login, selectable chapter text, one-click / multi-chapter copy for AI analysis.",
  "type": "module",
  "license": "MIT",
  "author": "edy",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "weread",
    "wechat-reading",
    "folio",
    "reader",
    "copy"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "main": "./packages/host/src/index.js",
  "exports": {
    ".": "./packages/host/src/index.js",
    "./client": "./packages/client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "NOTICE",
    "LICENSE",
    "packages/host/package.json",
    "packages/host/src",
    "packages/client/package.json",
    "packages/client/index.js",
    "packages/client/client.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.5 <0.3.0"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "scripts": {
    "build": "node packages/client/scripts/build-client.mjs",
    "test": "node --test test/*.test.js",
    "pack:dist": "npm run build && npm pack",
    "prepack": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoeyzhang233666/dsh-weread-reader.git"
  },
  "bugs": {
    "url": "https://github.com/zoeyzhang233666/dsh-weread-reader/issues"
  },
  "homepage": "https://github.com/zoeyzhang233666/dsh-weread-reader#readme"
}
